# ─── Scheduler ───
COLLECTION_DAY=3
COLLECTION_HOUR=6
LOOKBACK_DAYS=40

# ─── Mailjet (envoi vers Tiime) ───
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAIL_FROM=factures@votredomaine.com
TIIME_EMAIL=justif+kysoe@tiime.fr
MAIL_CC=

# ─── OVH ───
OVH_ENDPOINT=ovh-eu
OVH_APP_KEY=
OVH_APP_SECRET=
OVH_CONSUMER_KEY=

# ─── Scaleway ───
SCW_AUTH_TOKEN=
SCW_ORG_ID=

# ─── Microsoft 365 — Tenant 1 ───
MS365_TENANT1_ID=
MS365_TENANT1_CLIENT_ID=
MS365_TENANT1_SECRET=
MS365_TENANT1_BILLING_ACCOUNT=

# ─── Microsoft 365 — Tenant 2 ───
MS365_TENANT2_ID=
MS365_TENANT2_CLIENT_ID=
MS365_TENANT2_SECRET=
MS365_TENANT2_BILLING_ACCOUNT=

# ─── Qonto : UN SEUL des deux modes suffit ───
#
# Mode A — clé API (le plus simple, et ce que fournit Qonto par défaut).
# Dans Qonto : Paramètres → Intégrations → Clé API.
# QONTO_LOGIN est le slug de l'organisation (ex. « macompagnie-1234 »),
# QONTO_SECRET_KEY la clé secrète. Aucune autorisation navigateur.
QONTO_LOGIN=
QONTO_SECRET_KEY=
#
# Mode B — OAuth2, pour une application déclarée auprès de Qonto.
# Laisser vide si vous utilisez le mode A : ces valeurs ne sont PAS la clé API.
# Autoriser ensuite avec : python scripts/setup_qonto.py
QONTO_CLIENT_ID=
QONTO_CLIENT_SECRET=
QONTO_REDIRECT_URI=http://localhost:8080/callback
# organization.read = transactions, attachment.read = justificatifs,
# offline_access = refresh token (sans lui le jeton expire en 1 h)
QONTO_SCOPES=offline_access organization.read attachment.read

# ─── Qonto — justificatifs scannés attachés aux transactions ───
# Restaurants, taxis, achats ponctuels : tout ce qui n'a ni API ni facture par mail.
QONTO_ATTACHMENTS_ENABLED=false
# Commerçants déjà couverts par un provider dédié — évite d'envoyer deux fois le
# même justificatif à Tiime. Sous-chaînes, insensible à la casse.
QONTO_ATTACHMENTS_SKIP=ovh,scaleway,microsoft,google,atlassian,infomaniak,alan,mailjet,anthropic,mistral,certigna,clockify,starlink,youprice,apple,pokawa

# ─── Infomaniak ───
INFOMANIAK_API_TOKEN=
INFOMANIAK_ACCOUNT_ID=

# ─── Atlassian ───
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
ATLASSIAN_ACCOUNT_ID=

# ─── Playwright providers (opt-in) ───
FREE_MOBILE_ENABLED=false
FREE_MOBILE_USER=
FREE_MOBILE_PASS=

STARLINK_ENABLED=false
STARLINK_EMAIL=
STARLINK_PASS=

# YouPrice — espace client protégé par un code à usage unique envoyé par mail,
# lu automatiquement dans la boîte Gmail principale (comme Starlink).
YOUPRICE_ENABLED=false
YOUPRICE_USER=
YOUPRICE_PASS=

# Sosh — la facture est dans l'espace client Orange, le mail n'est qu'un avis.
# Identifiants du COMPTE ORANGE (souvent une adresse @orange.fr / @wanadoo.fr),
# pas l'adresse qui reçoit la notification. Si Orange envoie un code de
# vérification, il est lu automatiquement dans la boîte Gmail principale.
SOSH_ENABLED=false
SOSH_USER=
SOSH_PASS=

# ─── Gmail OAuth2 (lecture OTP Starlink/YouPrice + factures reçues par mail) ───
# Créer un OAuth2 Client ID (type "Desktop app") dans Google Cloud Console
# Activer l'API Gmail pour le projet
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8081/callback

# ─── Gmail — boîte secondaire (factures perso : reçus Apple…) ───
# Autoriser avec : python scripts/setup_gmail.py --account gmail_perso --email <adresse>
GMAIL_PERSO_ACCOUNT=gmail_perso

APPLE_MAIL_ENABLED=false

# Izivia (recharge véhicule) — facturé par EDF business services, PDF en pièce jointe
IZIVIA_MAIL_ENABLED=false

# ─── IMAP (boîte non-Gmail où arrivent certaines factures) ───
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# ─── Pokawa (mail simple sans PDF → le corps du mail est rendu en PDF) ───
POKAWA_ENABLED=false
POKAWA_SENDER=info@belorder.com

# ─── Storage ───
# Répertoire où sont stockés la base SQLite et les PDF (défaut: ./data)
DATA_DIR=~/Documents/boulot/factures2tiime
